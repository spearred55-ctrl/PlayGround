{
  "name": "battle-world-elite-survival",
  "version": "1.0.0",
  "private": true,
  "description": "BATTLE WORLD: ELITE SURVIVAL — an original 3D mobile battle royale built with Three.js.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build --base ./",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "node --test tests/*.test.mjs",
    "server": "node server/index.js",
    "android:add": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "node scripts/build-android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "three": "^0.187.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "vite": "^7.1.7"
  }
}
